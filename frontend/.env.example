# ADT Smart Farmer V2 - Frontend Environment Configuration Example
# Copy this template to frontend/.env.local or set in Vercel Project Settings.
# DO NOT commit .env or secrets to Git!

# Base URL for the ADT Smart Farmer V2 FastAPI Backend.
# For local web development (defaults to same-origin /api/v1 if unset):
# EXPO_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# For production Vercel deployment, point to your deployed HTTPS FastAPI backend:
EXPO_PUBLIC_API_BASE_URL="https://api.yourdomain.com/api/v1"
