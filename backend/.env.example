# ADT Smart Farmer V2 - Environment Configuration Example
# Copy this template to backend/.env and replace placeholders with your actual credentials.
# NEVER commit or expose backend/.env!

PROJECT_NAME="ADT Smart Farmer V2"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True

# Consolidated Server Binding
HOST="0.0.0.0"
PORT=8000

# Supabase Cloud Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase PostgreSQL Connection String (Session Pooler recommended for IPv4)
# Format: postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET="generate-a-secure-random-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"

# Copernicus Data Space Ecosystem (CDSE) Sentinel-2 Satellite Access
CDSE_CLIENT_ID="your-cdse-client-id"
CDSE_CLIENT_SECRET="your-cdse-client-secret"
CDSE_INSTANCE_ID="your-cdse-instance-id"

# Production Single-Origin Static Web Hosting
SERVE_STATIC_WEB=False
STATIC_WEB_DIR="../frontend/dist"

# Open-Meteo Commercial API Configuration
OPEN_METEO_API_KEY="your-commercial-open-meteo-api-key"
OPEN_METEO_BASE_URL="https://customer-api.open-meteo.com"
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPEN_METEO_CACHE_TTL_SECONDS=900

